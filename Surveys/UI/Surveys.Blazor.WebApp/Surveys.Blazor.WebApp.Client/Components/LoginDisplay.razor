@using System.Security.Claims
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Surveys.Blazor.WebApp.Client.Services
@inject NavigationManager Navigation
@inject AuthorizedHttpClient AuthorizedHttpClient
@inject AuthenticationStateProvider AuthenticationStateProvider


<Div Class="d-flex flex-fill align-items-center justify-content-center">
    <AuthorizeView>
        <Authorized>
            <Div Class="d-flex align-items-center gap-3">
                <Text TextSize="TextSize.Heading4">Hello, @context.User.Identity?.Name!</Text>
                <Button Color="Color.Primary" Clicked="BeginLogOut">Log out</Button>
                <Button Color="Color.Info" Clicked="GetRoles">Get User Roles</Button>
            </Div>
        </Authorized>
        <NotAuthorized>
            <Button Color="Color.Primary" Clicked="BeginLogIn">Log in</Button>
        </NotAuthorized>
    </AuthorizeView>
</Div>

@code{

    private async Task GetRoles()
    {
        HttpResponseMessage response = await AuthorizedHttpClient.GetAsync("https://localhost:10001/api/profiles/roles");
        AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal user = authState.User;

        if (response.IsSuccessStatusCode)
        {
            string rolesJson = await response.Content.ReadAsStringAsync();
            Console.WriteLine(rolesJson);

            IEnumerable<Claim> userClaims = user.Claims;

            foreach (Claim claim in userClaims)
            {
                Console.WriteLine($"{claim.Type}: {claim.Value}");
            }

            Console.WriteLine($"user.IsInRole(\"Administrator\") {user.IsInRole("Administrator")}");
        }
        else
        {
            Console.WriteLine($"Failed to retrieve roles. Status code: {response.StatusCode}");
        }
    }

    public void BeginLogOut()
    {
        Navigation.NavigateToLogout("authentication/logout");
    }

    public void BeginLogIn()
    {
        Navigation.NavigateToLogout("authentication/login");
    }

}