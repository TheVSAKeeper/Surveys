@using Surveys.Blazor.Components.Layout
@inherits LayoutComponentBase

@switch (layoutType)
{
    case "fixed-header":
        <Layout Sider>
            <LayoutSider>
                <LayoutSiderContent>
                    <SideMenu/>
                </LayoutSiderContent>
            </LayoutSider>
            <Layout>
                <LayoutHeader Fixed>
                    <TopMenu @bind-LayoutType="@layoutType"
                             ThemeColorChanged="@OnThemeColorChanged"
                             ThemeEnabledChanged="@OnThemeEnabledChanged"
                             ThemeGradientChanged="@OnThemeGradientChanged"
                             ThemeRoundedChanged="@OnThemeRoundedChanged"/>
                </LayoutHeader>
                <LayoutContent Padding="Padding.Is4.OnX.Is4.FromTop">
                    @Body
                </LayoutContent>
            </Layout>
        </Layout>

        break;

    case "fixed-header-footer-only":
        <Layout>
            <LayoutHeader Fixed>
                <TopMenu @bind-LayoutType="@layoutType"
                         ThemeColorChanged="@OnThemeColorChanged"
                         ThemeEnabledChanged="@OnThemeEnabledChanged"
                         ThemeGradientChanged="@OnThemeGradientChanged"
                         ThemeRoundedChanged="@OnThemeRoundedChanged"/>
            </LayoutHeader>
            <LayoutContent Padding="Padding.Is4.OnX.Is4.FromTop">
                @Body
            </LayoutContent>
            <LayoutFooter Fixed>
                <FooterMenu></FooterMenu>
            </LayoutFooter>
        </Layout>

        break;

    case "sider-with-header-on-top":
        <Layout>
            <LayoutHeader Fixed>
                <TopMenu @bind-LayoutType="@layoutType"
                         ThemeColorChanged="@OnThemeColorChanged"
                         ThemeEnabledChanged="@OnThemeEnabledChanged"
                         ThemeGradientChanged="@OnThemeGradientChanged"
                         ThemeRoundedChanged="@OnThemeRoundedChanged"/>
            </LayoutHeader>
            <Layout Sider>
                <LayoutSider>
                    <LayoutSiderContent>
                        <SideMenu/>
                    </LayoutSiderContent>
                </LayoutSider>
                <Layout>
                    <LayoutContent Padding="Padding.Is4.OnX.Is4.FromTop">
                        @Body
                    </LayoutContent>
                </Layout>
            </Layout>
        </Layout>

        break;
}