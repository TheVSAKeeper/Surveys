@using Surveys.Domain
@using Surveys.Web.Application.Messaging.QuestionOptionMessages.ViewModels
<Card Margin="Margin.Is3.FromBottom">
    <CardHeader>
        <CardTitle>@(char.ToUpper(Question.Text.First()) + Question.Text[1..])</CardTitle>
    </CardHeader>
    <CardBody>
        <Field>
            <FieldLabel>Ответ</FieldLabel>

            @switch (Question.Type)
            {
                case QuestionType.SingleChoice:
                case QuestionType.MultipleChoice:
                    <Select @bind-SelectedValue="@SelectedOption" @onfocusout="OnAnswerChanged" TValue="string">
                        <SelectItem Value="@string.Empty">@string.Empty</SelectItem>

                        @foreach (QuestionOptionViewModel option in Question.Options ?? [])
                        {
                            <SelectItem Value="@option.Value">@option.Value</SelectItem>
                        }
                    </Select>

                    break;

                case QuestionType.Text:
                    <TextEdit @bind-Text="@AnswerText" @onfocusout="OnAnswerChanged"/>

                    break;

                case QuestionType.Number:
                    <NumericEdit @bind-Value="@AnswerNumber" @onfocusout="OnAnswerChanged" TValue="decimal"/>

                    break;

                case QuestionType.Date:
                    <DateEdit @bind-Date="@AnswerDate" @onfocusout="OnAnswerChanged" TValue="DateTime"/>

                    break;

                case QuestionType.None:
                    break;

                default:
                    throw new ArgumentOutOfRangeException();
            }
        </Field>

    </CardBody>
</Card>