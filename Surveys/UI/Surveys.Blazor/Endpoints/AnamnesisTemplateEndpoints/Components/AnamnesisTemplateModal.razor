@using Surveys.Web.Application.Messaging.AnamnesisTemplateMessages.ViewModels
@using Surveys.Web.Application.Messaging.QuestionMessages.ViewModels
<Modal Centered @ref="_modal">
    <ModalContent Size="ModalSize.Fullscreen">
        <ModalHeader>
            <ModalTitle>Выберите шаблоны</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <Accordion>
                @foreach (AnamnesisTemplateViewModel template in Templates)
                {
                    <AccordionItem>
                        <AccordionHeader>
                            <Check @bind-Checked="@template.IsSelected" TValue="bool"></Check>
                            <AccordionToggle>@template.Title</AccordionToggle>
                        </AccordionHeader>
                        <AccordionBody>
                            @if (template.Description is not null)
                            {
                                <p>@template.Description</p>
                            }
                            else
                            {
                                <p>Нет описания</p>
                            }

                            @if (template.Questions.Count != 0)
                            {
                                <ListView Data="template.Questions"
                                          MaxHeight="300px"
                                          Mode="ListGroupMode.Static"
                                          TextField="item => item.Text"
                                          TItem="QuestionViewModel"
                                          ValueField="item => item.Text">
                                </ListView>
                            }
                            else
                            {
                                <p>Нет вопросов</p>
                            }

                        </AccordionBody>
                    </AccordionItem>
                }
            </Accordion>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Primary" @onclick="SaveAndClose">Сохранять</Button>
            <Button Color="Color.Secondary" @onclick="CloseModal">Отмена</Button>
        </ModalFooter>
    </ModalContent>
</Modal>
