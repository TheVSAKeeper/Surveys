@using Blazorise.Icons.FontAwesome
@using Surveys.Blazor.Endpoints.ResponseEndpoints.Components
@using Surveys.Web.Application.Messaging.ResponseMessages.ViewModels

<Card Margin="Margin.Is3.FromBottom">
    <CardHeader>
        <CardTitle>
            @(AnamnesisTemplate?.Title ?? "Нет названия")
            <Blazorise.Icons.FontAwesome.Icon Name="@(Anamnesis.IsComplete ? FontAwesomeIcons.CheckCircle : FontAwesomeIcons.CircleXmark)" TextColor="@(Anamnesis.IsComplete ? TextColor.Success : TextColor.Danger)"/>
        </CardTitle>
    </CardHeader>
    <CardBody>
        @if (Anamnesis.Responses != null)
        {
            <Paragraph>
                Количество вопросов/ответов: @AnamnesisTemplate?.Questions.Count /
                @Anamnesis.Responses.Count(response => response.Answers.Any(answer => string.IsNullOrWhiteSpace(answer.Value) == false))
            </Paragraph>

            @foreach (ResponseViewModel response in Anamnesis.Responses)
            {
                <ResponseCard AnswerChanged="OnAnswerChanged" Response="@response"/>
            }
        }
        else
        {
            <Paragraph>Не найден отклик</Paragraph>
        }
    </CardBody>
</Card>