@using Surveys.Blazor.Endpoints.ResponseEndpoints.Components
@using Surveys.Web.Application.Messaging.ResponseMessages.ViewModels
<Card>
    <CardHeader>
        <CardTitle>
            @(Anamnesis.AnamnesisTemplate?.Title ?? "Неизвестно")<Check Checked="@Anamnesis.IsComplete" Disabled="true"/>
        </CardTitle>
    </CardHeader>
    <CardBody>
        @if (Anamnesis.Responses != null)
        {
            <Paragraph>Не найден отклик @Anamnesis.Responses.Count</Paragraph>

            foreach (ResponseViewModel response in Anamnesis.Responses)
            {
                <ResponseCard Response="@response"/>
            }
        }
        else
        {
            <Paragraph>Не найден отклик</Paragraph>
        }
    </CardBody>
</Card>