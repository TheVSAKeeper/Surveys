@using Blazorise.Localization
<Bar Background="Background.Primary" @bind-Visible="@_topbarVisible" Breakpoint="Breakpoint.Desktop" ThemeContrast="ThemeContrast.Light">
    <BarBrand>
        <BarItem>
            <BarLink To="">
                <BarIcon IconName="IconName.Dashboard" Margin="Margin.Is2.FromEnd"/>
                Опросы
            </BarLink>
        </BarItem>
    </BarBrand>
    <BarToggler/>
    <BarMenu>
        <BarStart>
            <BarItem>
                <BarLink To="/">Дом</BarLink>
            </BarItem>
            <BarItem>
                <BarDropdown>
                    <BarDropdownToggle>Макет</BarDropdownToggle>
                    <BarDropdownMenu>
                        <BarDropdownItem Clicked="@(() => OnLayoutTypeChecked("fixed-header"))">
                            @if (LayoutType == "fixed-header")
                            {
                                <Icon Name="IconName.CheckCircle" TextColor="TextColor.Success"/>
                            }
                            Фиксированный заголовок
                        </BarDropdownItem>
                        <BarDropdownItem Clicked="@(() => OnLayoutTypeChecked("fixed-header-footer-only"))">
                            @if (LayoutType == "fixed-header-footer-only")
                            {
                                <Icon Name="IconName.CheckCircle" TextColor="TextColor.Success"/>
                            }
                            Только фиксированный верхний и нижний колонтитулы
                        </BarDropdownItem>
                        <BarDropdownItem Clicked="@(() => OnLayoutTypeChecked("sider-with-header-on-top"))">
                            @if (LayoutType == "sider-with-header-on-top")
                            {
                                <Icon Name="IconName.CheckCircle" TextColor="TextColor.Success"/>
                            }
                            Сайдер с заголовком сверху
                        </BarDropdownItem>
                    </BarDropdownMenu>
                </BarDropdown>
            </BarItem>

        </BarStart>
        <BarEnd>
            <BarItem>
                <LoginDisplay></LoginDisplay>
            </BarItem>
            <BarItem>
                <BarDropdown RightAligned>
                    <BarDropdownToggle><Icon Name="IconName.Tint"/> Theme</BarDropdownToggle>
                    <BarDropdownMenu Style="padding: 15px; min-width:550px;">
                        <Row>
                            <Column Margin="Margin.Is2.FromBottom">
                                <Field>
                                    <Switch Checked="@(Theme?.Enabled == true)" CheckedChanged="@ThemeEnabledChanged" TValue="bool">Тема включена</Switch>
                                </Field>
                            </Column>
                        </Row>
                        <Row>
                            <Column Margin="Margin.Is2.FromBottom">
                                <Field>
                                    <Check Checked="@(Theme?.IsGradient == true)" CheckedChanged="@ThemeGradientChanged" TValue="bool">Градиентные цвета</Check>
                                </Field>
                                <Field>
                                    <Check Checked="@(Theme?.IsRounded == true)" CheckedChanged="@ThemeRoundedChanged" TValue="bool">Закругленные элементы</Check>
                                </Field>
                            </Column>
                        </Row>
                        <Row>
                            <Column>
                                <Container Fluid>
                                    <ThemeColorSelector Value="@(Theme?.ColorOptions?.Primary)" ValueChanged="@ThemeColorChanged"></ThemeColorSelector>
                                </Container>
                            </Column>
                        </Row>
                    </BarDropdownMenu>
                </BarDropdown>
            </BarItem>
        </BarEnd>
    </BarMenu>
</Bar>

@code {
    [Parameter] public EventCallback<bool> ThemeEnabledChanged { get; set; }
    [Parameter] public EventCallback<bool> ThemeGradientChanged { get; set; }
    [Parameter] public EventCallback<bool> ThemeRoundedChanged { get; set; }
    [Parameter] public EventCallback<string> ThemeColorChanged { get; set; }

    [Parameter] public string? LayoutType { get; set; }
    [Parameter] public EventCallback<string> LayoutTypeChanged { get; set; }

    [Inject] protected ITextLocalizerService? LocalizationService { get; set; }

    [CascadingParameter] protected Theme? Theme { get; set; }

    private bool _topbarVisible = false;

    protected override async Task OnInitializedAsync()
    {
        await SelectCulture("ru");

        await base.OnInitializedAsync();
    }

    private Task SelectCulture(string name)
    {
        LocalizationService!.ChangeLanguage(name);

        return Task.CompletedTask;
    }

    private Task OnLayoutTypeChecked(string layoutType)
    {
        LayoutType = layoutType;

        return LayoutTypeChanged.InvokeAsync(layoutType);
    }

}