@page "/survey-update/{id:guid}"
@using Surveys.Blazor.Endpoints.AnamnesisEndpoints.Components
@using Surveys.Blazor.Endpoints.AnamnesisTemplateEndpoints.Components
@using Surveys.Blazor.Endpoints.PatientEndpoints.Components
@using Surveys.Domain
@using Surveys.Web.Application.Messaging.AnamnesisMessages

@if (ViewModel is not null)
{
    <Card>
        <CardHeader>
            <CardTitle>Информация об опросе</CardTitle>
        </CardHeader>
        <CardBody>
            <Row>
                <Column ColumnSize="ColumnSize.Is12">
                    <EditForm Model="@ViewModel">
                        <Validations HandlerType="typeof(FluentValidationHandler)" Mode="ValidationMode.Auto" Model="@ViewModel" @ref="@_fluentValidations">
                            <Validation>
                                <Field>
                                    <FieldLabel>
                                        <Icon Name="IconName.Edit"/> Жалоба
                                    </FieldLabel>
                                    <TextEdit @bind-Text="@ViewModel.Complaint" Placeholder="Введите жалобу">
                                        <Feedback>
                                            <ValidationError/>
                                        </Feedback>
                                    </TextEdit>
                                </Field>
                            </Validation>
                        </Validations>

                        <Field>
                            <FieldLabel>
                                Статус
                            </FieldLabel>
                            <Select @bind-SelectedValue="@ViewModel.Status">
                                @foreach (string value in Enum.GetNames(typeof(SurveyStatus)))
                                {
                                    <SelectItem Value="@value">@value</SelectItem>
                                }
                            </Select>
                        </Field>
                    </EditForm>
                </Column>
            </Row>

            <Row>
                <Column ColumnSize="ColumnSize.Is12">
                    <Field>
                        <FieldLabel>Пациент</FieldLabel>
                        <PatientInfoComponent ViewModel="@ViewModel.Patient"/>
                    </Field>
                </Column>
            </Row>

            <Row>
                <Column ColumnSize="ColumnSize.Is12">
                    <Field>
                        <FieldLabel>Анамнезы</FieldLabel>
                        <AnamnesisTemplateModal OnTemplatesSelected="HandleTemplatesSelected" @ref="_anamnesisTemplateModal"/>

                        @if (ViewModel.Anamneses.Any())
                        {
                            foreach (AnamnesisViewModel anamnesis in ViewModel.Anamneses)
                            {
                                <AnamnesisCard Anamnesis="@anamnesis" OnChanged="OnAnswerChanged"/>
                            }
                        }
                        else
                        {
                            <TextEdit ReadOnly="true" Text="No anamneses available"/>
                        }
                    </Field>
                </Column>
            </Row>

            <Row>
                <Column ColumnSize="ColumnSize.Is6">
                    <Button Clicked="() => _anamnesisTemplateModal.Show()" Color="Color.Primary">
                        <Icon Name="IconName.Add"/> Добавить
                    </Button>
                </Column>
                <Column ColumnSize="ColumnSize.Is6">
                    <Button Clicked="OnSaveSurveyClicked" Color="Color.Primary">
                        <Icon Name="IconName.Save"/> Сохранить
                    </Button>
                </Column>
            </Row>

        </CardBody>
    </Card>
}
else
{
    <Paragraph>Загрузка...</Paragraph>
}