<Modal @ref="_modal">
    <ModalContent Centered>
        <ModalHeader>
            <ModalTitle>
                <Icon Name="IconName.Pen"/> Создание опроса
            </ModalTitle>
            <CloseButton/>
        </ModalHeader>
        <ModalBody>
            @if (_createViewModel is { Patient: not null })
            {
                <Div class="mb-3">
                    <Heading Size="HeadingSize.Is5">
                        Информация о пациенте
                    </Heading>
                    <Paragraph>
                        Имя: @_createViewModel.Patient.FirstName @_createViewModel.Patient.LastName @_createViewModel.Patient.Patronymic
                    </Paragraph>
                    <Paragraph>
                        Дата рождения: @_createViewModel.Patient.BirthDate.ToString("d")
                    </Paragraph>
                    <Paragraph>
                        Пол: @_createViewModel.Patient.Gender.ToString()
                    </Paragraph>
                </Div>

                <EditForm Model="@_createViewModel" OnValidSubmit="SubmitComplaint">
                    <Validations HandlerType="typeof(FluentValidationHandler)" Mode="ValidationMode.Auto" Model="@_createViewModel" @ref="@_fluentValidations">
                        <Validation>
                            <Field>
                                <FieldLabel>
                                    <Icon Name="IconName.Edit"/> Жалоба
                                </FieldLabel>
                                <TextEdit @bind-Text="@_createViewModel.Complaint" Placeholder="Введите жалобу">
                                    <Feedback>
                                        <ValidationError/>
                                    </Feedback>
                                </TextEdit>
                            </Field>
                        </Validation>
                    </Validations>

                    <Button Color="Color.Primary" Type="ButtonType.Submit">
                        <Icon Name="IconName.Check"/> Подтвердить
                    </Button>
                </EditForm>
            }

        </ModalBody>
    </ModalContent>
</Modal>