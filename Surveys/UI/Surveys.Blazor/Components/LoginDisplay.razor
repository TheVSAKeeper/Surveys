<Div Class="align-items-center d-flex flex-fill justify-content-center">
    <AuthorizeView>
        <Authorized>
            <Div Class="align-items-center d-flex gap-3">
                <Text TextSize="TextSize.Heading4">Hello, @context.User.Identity?.Name!</Text>
                <Button Clicked="BeginLogOut" Color="Color.Primary">Log out</Button>
            </Div>
        </Authorized>
        <NotAuthorized>
            <Button Clicked="BeginLogIn" Color="Color.Primary">Log in</Button>
        </NotAuthorized>
    </AuthorizeView>
</Div>