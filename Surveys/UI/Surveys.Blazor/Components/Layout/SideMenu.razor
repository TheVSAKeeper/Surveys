@using Surveys.Blazor.Domain
<Bar Breakpoint="Breakpoint.Desktop" CollapseMode="BarCollapseMode.Small" Mode="BarMode.VerticalInline"
     NavigationBreakpoint="Breakpoint.Tablet" ThemeContrast="ThemeContrast.Dark">
    <BarToggler/>
    <BarBrand>
        <BarItem>
            <BarLink To="">
                <BarIcon IconName="customIcon"/>
                Опросы
            </BarLink>
        </BarItem>
    </BarBrand>
    <BarMenu>
        <BarStart>
            <BarItem>
                <BarLink To="/">
                    <BarIcon IconName="IconName.Dashboard"/>
                    Главная страница
                </BarLink>
            </BarItem>
            <AuthorizeView Roles="@AppData.SystemAdministratorRoleName">
                <BarItem>
                    <BarDropdown @bind-Visible="pagesBarVisible">
                        <BarDropdownToggle>
                            <BarIcon IconName="IconName.Edit"/>
                            Страницы
                        </BarDropdownToggle>
                        <BarDropdownMenu>
                            <BarDropdownItem To="/patients">Пациенты</BarDropdownItem>
                        </BarDropdownMenu>
                    </BarDropdown>
                </BarItem>
            </AuthorizeView>
            <AuthorizeView Roles="@AppData.DoctorRoleName">
                <BarItem>
                    <BarDropdown @bind-Visible="pagesBarVisible">
                        <BarDropdownToggle>
                            <BarIcon IconName="IconName.Edit"/>
                            Страницы
                        </BarDropdownToggle>
                        <BarDropdownMenu>
                            <BarDropdownItem To="/patients">Пациенты</BarDropdownItem>
                        </BarDropdownMenu>
                    </BarDropdown>
                </BarItem>
            </AuthorizeView>
            <AuthorizeView Roles="@AppData.NurseRoleName">
                <BarItem>
                    <BarDropdown @bind-Visible="pagesBarVisible">
                        <BarDropdownToggle>
                            <BarIcon IconName="IconName.Edit"/>
                            Страницы
                        </BarDropdownToggle>
                        <BarDropdownMenu>
                            <BarDropdownItem To="/patients">Пациенты</BarDropdownItem>
                        </BarDropdownMenu>
                    </BarDropdown>
                </BarItem>
            </AuthorizeView>
        </BarStart>
    </BarMenu>
</Bar>

@code {
    private bool pagesBarVisible = true;

    RenderFragment customIcon = @<img src="/brand-logo.png" style="width:32px; height: 32px"/>;

}