@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Surveys.Web.Pages.Connect.LoginModel

<div class="m6 w3-content w3-padding-16" style="max-width: 400px;">
    @if (Model.Input != null)
    {
        <form method="post">
            <input asp-for="@Model.Input.ReturnUrl" type="hidden" />

            <div asp-validation-summary="All" class="w3-text-red"></div>

            <div class="w3-section">
                <label asp-for="@Model.Input.UserName" class="w3-label" style="font-weight: bold;"></label>
                <input asp-for="@Model.Input.UserName" class="w3-border w3-input w3-margin-bottom" type="email">
            </div>

            <div class="w3-section">
                <label asp-for="@Model.Input.Password" class="w3-label" style="font-weight: bold;"></label>
                <input asp-for="@Model.Input.Password" class="w3-border w3-input" type="password" />
            </div>
            <div class="w3-section">
                <button class="w3-block w3-blue w3-button w3-padding w3-section" type="submit">Вход</button>
            </div>
        </form>
    }
</div>
